#!/bin/sh
# ==============================================================================
# NanoPi R3S LTS 物理电源按键安全关机脚本
# 路径：/etc/rc.button/power
# 说明：当机身物理电源键被按下并释放时，procd 热插拔事件总线会自动调用此脚本。
# ==============================================================================

# 仅在按键释放 (released) 时触发关机
[ "$ACTION" = "released" ] && {
    # 1. 记录关机事件到系统日志 (/var/log/messages 或 logread)
    logger "LTS Power button pressed, executing safe shutdown..."

    # 2. 请求将待写缓存同步到存储设备
    sync

    # 3. 触发系统关机流程
    poweroff
}
