#!/bin/sh
# ==============================================================================
# NanoPi R3S LTS 系统开机自销毁初始化配置脚本
# 路径：/etc/uci-defaults/99-r3s-optimize
# 原理：OpenWrt 在初次开机、网络服务启动前会自动执行此目录下的所有脚本；
#       执行完毕返回 0 后，系统会自动将其从磁盘中删除，完全不留运行时垃圾。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 设置默认后台 root 密码为 password
# ------------------------------------------------------------------------------
echo -e "password\npassword" | passwd root 2>/dev/null || true

# ------------------------------------------------------------------------------
# 2. 修改默认 LAN 口后台管理 IP 为 10.0.0.1 (防与光猫默认 192.168.1.1 产生 IP 冲突)
# 核心注意：ImmortalWrt / OpenWrt 25.12 的 netifd 要求必须显式声明 /24 CIDR 前缀或 netmask，
#           否则网卡会被降级识别为 10.0.0.1/32 单机掩码，导致 dnsmasq 认为无可用网段而停发 DHCP 租约！
# ------------------------------------------------------------------------------
uci -q delete network.lan.ipaddr
uci -q add_list network.lan.ipaddr='10.0.0.1/24'
uci -q set network.lan.netmask='255.255.255.0'
uci -q commit network || true

# 显式配置 dnsmasq 的 LAN DHCP 动态地址池 (10.0.0.100 ~ 10.0.0.249，租期 12h)
uci -q set dhcp.lan.start='100'
uci -q set dhcp.lan.limit='150'
uci -q set dhcp.lan.leasetime='12h'
uci -q commit dhcp || true

# ------------------------------------------------------------------------------
# 3. 配置系统主机名与时区 (NanoPi-R3S / Asia/Shanghai / CST-8)
# ------------------------------------------------------------------------------
uci -q set system.@system[0].hostname='NanoPi-R3S'
uci -q set system.@system[0].zonename='Asia/Shanghai'
uci -q set system.@system[0].timezone='CST-8'
uci -q commit system || true

# ------------------------------------------------------------------------------
# 4. 开启网络软中断负载均衡 (Packet Steering / RPS)
# 原理：硬中断已被官方绑在 CPU1/CPU2，开 RPS 让软中断处理平摊到 CPU0/CPU3，四核负载完全均衡
# ------------------------------------------------------------------------------
uci -q set network.globals.packet_steering='1'
uci -q commit network || true

# ------------------------------------------------------------------------------
# 5. 开启软件流量分载 (Flow Offloading)
# 原理：RK3566 无硬件 NAT 引擎，开启软件卸载后可降低 NAT 转发 CPU 占用 30%~50%
# ------------------------------------------------------------------------------
uci -q set firewall.@defaults[0].flow_offloading='1'
uci -q commit firewall || true

# ------------------------------------------------------------------------------
# 6. 加大 dnsmasq 本地 DNS 缓存大小至 4096 条
# 作用：国内高频访问域名全部在路由器内存中秒级命中，大幅降低页面首包延迟
# ------------------------------------------------------------------------------
uci -q set dhcp.@dnsmasq[0].cachesize='4096'
uci -q commit dhcp || true

# ------------------------------------------------------------------------------
# 7. CPU 调速策略锁定性能模式 (Performance Governor)
# 作用：消除 CPU 动态升频带来的瞬时延迟，保障小包千兆线速转发与代理加解密流畅
# ------------------------------------------------------------------------------
uci -q set cpufreq.@settings[0].governor='performance'
uci -q commit cpufreq 2>/dev/null || true

# ------------------------------------------------------------------------------
# 8. 优化 nlbwmon 流量统计 (监控 10.0.0.0/24 并将数据库持久化落盘至 eMMC)
# 作用：避免将流量统计数据常驻在紧凑的 1GB 内存中，节省内存并防止重启丢失统计数据
# ------------------------------------------------------------------------------
mkdir -p /etc/nlbwmon
uci -q set nlbwmon.@nlbwmon[0].local_network='10.0.0.0/24'
uci -q set nlbwmon.@nlbwmon[0].database_directory='/etc/nlbwmon'
uci -q commit nlbwmon 2>/dev/null || true

# ------------------------------------------------------------------------------
# 9. 配置国内高精度 NTP 时间同步服务器 (阿里云 / 腾讯云)
# 作用：保障 sing-box 的 TLS / VLESS-Reality 握手时间戳精准，避免因时间偏移导致握手失败
# ------------------------------------------------------------------------------
uci -q delete system.ntp.server
uci -q add_list system.ntp.server='ntp1.aliyun.com'
uci -q add_list system.ntp.server='ntp2.aliyun.com'
uci -q add_list system.ntp.server='time1.cloud.tencent.com'
uci -q commit system || true

exit 0
