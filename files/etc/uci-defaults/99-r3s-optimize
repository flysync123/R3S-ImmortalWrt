#!/bin/sh
# R3S defaults run before network services. Success removes this script; failures
# must leave it available for the next boot. Never change /etc/shadow here.
# /etc/config/r3s is explicitly included in /lib/upgrade/keep.d/r3s-defaults.

log() {
	logger -t r3s-defaults -- "$*" 2>/dev/null || printf 'r3s-defaults: %s\n' "$*" >&2
}

fail() {
	log "ERROR: $*; script retained for the next boot"
	exit 1
}

checked_uci() {
	uci -q "$@" || { log "UCI failed: $*"; return 1; }
}

configure_network() {
	if uci -q get network.lan.ipaddr >/dev/null; then
		checked_uci delete network.lan.ipaddr || return 1
	fi
	checked_uci set network.lan.proto='static' &&
	checked_uci add_list network.lan.ipaddr='10.0.0.1/24' &&
	checked_uci set network.lan.netmask='255.255.255.0' &&
	checked_uci set network.globals.packet_steering='1'
}

configure_dhcp() {
	checked_uci set dhcp.lan.start='100' &&
	checked_uci set dhcp.lan.limit='150' &&
	checked_uci set dhcp.lan.leasetime='12h' &&
	checked_uci set dhcp.@dnsmasq[0].cachesize='4096'
}

configure_system() {
	checked_uci set system.@system[0].hostname='NanoPi-R3S' &&
	checked_uci set system.@system[0].zonename='Asia/Shanghai' &&
	checked_uci set system.@system[0].timezone='CST-8' || return 1
	if uci -q get system.ntp.server >/dev/null; then
		checked_uci delete system.ntp.server || return 1
	fi
	checked_uci add_list system.ntp.server='ntp1.aliyun.com' &&
	checked_uci add_list system.ntp.server='ntp2.aliyun.com' &&
	checked_uci add_list system.ntp.server='time1.cloud.tencent.com'
}

configure_firewall() {
	checked_uci set firewall.@defaults[0].flow_offloading='1'
}

configure_nlbwmon() {
	local entry old_networks
	# Interface names resolve both IPv4 and IPv6 subnets at service start.
	# Preserve explicit IPv6 ranges supplied by the upstream package.
	old_networks="$(uci -q get nlbwmon.@nlbwmon[0].local_network)"
	if [ -n "$old_networks" ]; then
		checked_uci delete nlbwmon.@nlbwmon[0].local_network || return 1
	fi
	checked_uci add_list nlbwmon.@nlbwmon[0].local_network='lan' || return 1
	for entry in $old_networks; do
		case "$entry" in
			*:*) checked_uci add_list "nlbwmon.@nlbwmon[0].local_network=$entry" || return 1 ;;
		esac
	done
	mkdir -p /etc/nlbwmon || return 1
	checked_uci set nlbwmon.@nlbwmon[0].database_directory='/etc/nlbwmon'
}

# Save the checkpoint before committing the package. If power is lost between
# these writes, prefer keeping the current configuration over reapplying a
# default that could replace a user's later changes. That conservative window
# may leave a first-boot default unapplied and requires checking the configuration.
run_phase() {
	local phase="$1" package="$2" function="$3"
	[ "$(uci -q get "r3s.state.$phase")" = '1' ] && return 0
	if ! "$function"; then
		uci -q revert "$package"
		fail "Cannot configure $package"
	fi
	checked_uci set "r3s.state.$phase=1" && checked_uci commit r3s || {
		uci -q revert r3s
		uci -q revert "$package"
		fail "Cannot checkpoint $package"
	}
	if ! checked_uci commit "$package"; then
		uci -q revert "$package"
		if ! checked_uci delete "r3s.state.$phase" || ! checked_uci commit r3s; then
			uci -q revert r3s
			log "Cannot clear $package checkpoint; retaining the current configuration on retry"
		fi
		fail "Cannot commit $package"
	fi
}

migrate_nlbwmon() {
	local scalar entry old_networks exported
	# UCI get hides option/list type. Only repair scalar values: valid lists and
	# customized database locations on existing installations stay unchanged.
	exported="$(uci -q export nlbwmon)" || { log 'Cannot read nlbwmon configuration'; return 1; }
	scalar="$(printf '%s\n' "$exported" | awk '
		/^config / {
			target = ($2 == "nlbwmon" && !seen)
			if (target) seen = 1
		}
		target && $1 == "option" && $2 == "local_network" { print; exit }
	')"
	[ -n "$scalar" ] || return 0
	old_networks="$(uci -q get nlbwmon.@nlbwmon[0].local_network)"
	[ -n "$old_networks" ] || return 0
	checked_uci delete nlbwmon.@nlbwmon[0].local_network || return 1
	# Treat whitespace-separated scalar networks as individual list entries.
	# Only the known obsolete R3S subnet is replaced with its LAN interface.
	set -f
	for entry in $old_networks; do
		[ "$entry" = '10.0.0.0/24' ] && entry='lan'
		checked_uci add_list "nlbwmon.@nlbwmon[0].local_network=$entry" || { set +f; return 1; }
	done
	set +f
	checked_uci commit nlbwmon
}

command -v uci >/dev/null 2>&1 || fail 'uci is unavailable'

# The preinit hook records restore state before another defaults script can
# remove the restore archive. Missing/unknown state always preserves settings.
boot_state="$(cat /tmp/r3s-boot-state 2>/dev/null)"
mode="$(uci -q get r3s.state.mode)"
# A restored backup wins even over an unfinished first-boot checkpoint.
if [ "$boot_state" = 'restored' ] || [ -e /etc/.updated ] ||
   [ -e /sysupgrade.tgz ] || [ -e /tmp/sysupgrade.tar ] ||
   [ -e /etc/uci-defaults/10_disable_services ]; then
	mode='existing'
elif [ "$mode" = 'fresh' ] && [ "$boot_state" != 'fresh' ] &&
     [ "$(uci -q get r3s.state.defaults_version)" != '1' ]; then
	# The prior first boot stopped early. A later boot cannot tell whether the
	# user has since changed LAN/DHCP, so do not resume applying fresh defaults.
	log 'First-boot defaults were interrupted; keeping current settings. Check LAN, DHCP and system defaults manually.'
	mode='existing'
elif [ -z "$mode" ]; then
	mode='existing'
	[ "$boot_state" = 'fresh' ] && mode='fresh'
fi
if [ "$(uci -q get r3s.state.mode)" != "$mode" ]; then
	[ -e /etc/config/r3s ] || : > /etc/config/r3s || fail 'Cannot create initialization state'
	checked_uci set r3s.state='r3s' &&
	checked_uci set "r3s.state.mode=$mode" &&
	checked_uci commit r3s || { uci -q revert r3s; fail 'Cannot save initialization state'; }
fi

if [ "$mode" = 'fresh' ] && [ "$(uci -q get r3s.state.defaults_version)" != '1' ]; then
	run_phase network_done network configure_network
	run_phase dhcp_done dhcp configure_dhcp
	run_phase system_done system configure_system
	# Missing optional services are normal for different build variants.
	if uci -q get firewall.@defaults[0] >/dev/null; then
		run_phase firewall_done firewall configure_firewall
	fi
	if uci -q get nlbwmon.@nlbwmon[0] >/dev/null; then
		run_phase nlbwmon_done nlbwmon configure_nlbwmon
	fi
fi

if uci -q get nlbwmon.@nlbwmon[0] >/dev/null; then
	migrate_nlbwmon || { uci -q revert nlbwmon; fail 'Cannot migrate nlbwmon'; }
fi

# governor was never consumed by this service (it uses governor0, etc.). Remove
# that obsolete setting only; keep the upstream or user-selected active policy.
if [ "$(uci -q get cpufreq.@settings[0].governor)" = 'performance' ]; then
	checked_uci delete cpufreq.@settings[0].governor && checked_uci commit cpufreq || {
		uci -q revert cpufreq
		fail 'Cannot remove obsolete cpufreq option'
	}
fi

checked_uci set r3s.state.defaults_version='1' && checked_uci commit r3s || {
	uci -q revert r3s
	fail 'Cannot finish initialization state'
}
log "Defaults complete (installation state: $mode)"
exit 0
