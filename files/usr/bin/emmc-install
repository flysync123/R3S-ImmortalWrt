#!/bin/sh
# ==============================================================================
# NanoPi R3S / R3S LTS 专属 eMMC 一键刷写迁移工具 (Inspired by sbwml/builder)
# 用法：在 TF 卡系统中执行 `emmc-install /tmp/firmware.img.gz` 或直接 `emmc-install`
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
PLAIN='\033[0m'

echo -e "${GREEN}======================================================${PLAIN}"
echo -e "${GREEN}    NanoPi R3S LTS - eMMC 一键刷机迁移工具 (32GB)      ${PLAIN}"
echo -e "${GREEN}======================================================${PLAIN}"

# 1. 检查当前是否从 TF 卡启动
CURRENT_ROOT=$(mount | grep ' / ' | awk '{print $1}')
if echo "$CURRENT_ROOT" | grep -q 'mmcblk0'; then
    echo -e "${YELLOW}[提示] 当前系统已经在 eMMC (/dev/mmcblk0) 上运行！无需二次刷入。${PLAIN}"
    exit 0
fi

# 2. 定位板载 eMMC 块设备
EMMC_DEV="/dev/mmcblk0"
if [ ! -b "$EMMC_DEV" ]; then
    echo -e "${RED}[错误] 未检测到板载 eMMC 设备 ($EMMC_DEV)！${PLAIN}"
    exit 1
fi

# 3. 获取待写入的固件镜像路径
IMG_FILE="$1"
if [ -z "$IMG_FILE" ]; then
    # 自动在 /tmp 目录下寻找可用的固件
    IMG_FILE=$(find /tmp -maxdepth 2 -type f \( -name "*sysupgrade*.img.gz" -o -name "*rockchip*.img.gz" -o -name "*.img" \) | head -n1)
fi

if [ -z "$IMG_FILE" ] || [ ! -f "$IMG_FILE" ]; then
    echo -e "${RED}[错误] 未找到待写入的固件文件！${PLAIN}"
    echo -e "${YELLOW}请先将固件上传至 /tmp 目录，例如：/tmp/firmware.img.gz${PLAIN}"
    echo -e "用法：${GREEN}emmc-install /tmp/firmware.img.gz${PLAIN}"
    exit 1
fi

echo -e "${GREEN}[1/4] 检测到待写入固件: ${PLAIN}${IMG_FILE}"
echo -e "${GREEN}[2/4] 目标写入设备: ${PLAIN}${EMMC_DEV} (板载 32GB eMMC)"
echo -e "${YELLOW}[警告] 写入将清除 eMMC 中的所有数据，请确保已备份重要数据！${PLAIN}"

# 4. 执行写入
echo -e "${GREEN}[3/4] 正在解压并写入 eMMC，请稍候...${PLAIN}"
if echo "$IMG_FILE" | grep -q '\.gz$'; then
    zcat "$IMG_FILE" | dd of="$EMMC_DEV" bs=4M conv=fsync status=progress
elif echo "$IMG_FILE" | grep -q '\.zst$'; then
    zstd -d -c "$IMG_FILE" | dd of="$EMMC_DEV" bs=4M conv=fsync status=progress
else
    dd if="$IMG_FILE" of="$EMMC_DEV" bs=4M conv=fsync status=progress
fi

sync

# 5. 提示完成
echo -e "${GREEN}[4/4] 写入成功！数据已强制同步刷盘 (Sync Complete)。${PLAIN}"
echo -e "${GREEN}======================================================${PLAIN}"
echo -e "${GREEN}  刷机已全部完成！请按以下步骤操作：                ${PLAIN}"
echo -e "${GREEN}  1. 拔掉电源断电                                     ${PLAIN}"
echo -e "${YELLOW}  2. 务必将 MicroSD (TF) 卡从卡槽拔出                  ${PLAIN}"
echo -e "${GREEN}  3. 重新通电，设备将从 32GB eMMC 极速启动！         ${PLAIN}"
echo -e "${GREEN}======================================================${PLAIN}"
